# 代理设置（国内网络访问 hanime 需要代理）
USE_PROXY=true
PROXY_URL=http://your-proxy-host:port

# 视频下载代理（一般不需要，下载可以直接访问）
USE_DOWNLOAD_PROXY=false
DOWNLOAD_PROXY_URL=http://your-proxy-host:port

# cf-bypass 服务地址（可选，如果启用了 cf-bypass 容器则填写）
# 留空则使用上面的 PROXY_URL 代理直连
CLOUDFLARE_BYPASS_SERVICE_URL=

# MinIO 对象存储（v4.0.0 可选，封面/头像等图片存储）
# 默认与 MySQL 同主机，端口 9001，账号密码 minioadmin
USE_MINIO=true
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hanime
