# 应用配置
APP_NAME=HanimeViewer
APP_DESCRIPTION=HanimeViewer API服务
APP_VERSION=1.0.0
RELOAD=False

# 端口配置
HOST=0.0.0.0
PORT=8000

# API配置
HANIME_BASE_URL=https://hanime1.me

# 文件路径
DATA_ROOT=/app/backend/data
DOWNLOAD_PATH=/app/backend/data/downloads
LOG_PATH=/app/backend/logs

# 代理设置
USE_PROXY=False
PROXY_URL=http://your-proxy-host:port
USE_DOWNLOAD_PROXY=False
DOWNLOAD_PROXY_URL=http://your-proxy-host:port

# 爬虫设置
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# 日志设置
LOG_LEVEL=INFO

# MySQL云数据库设置（可选，用于多项目共用用户数据）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=librarydream

# MinIO 对象存储（v4.0.0 可选，封面/头像等图片存储，项目专用 bucket）
USE_MINIO=false
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hanime

# 同时下载的最大视频数（v4.0.0，超出排队等待）
MAX_CONCURRENT_DOWNLOADS=3